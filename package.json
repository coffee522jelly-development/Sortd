{
  "name": "app",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.example.desktop-organizer",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DesktopOrganizer"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coffee522jelly-development/Sortd.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/coffee522jelly-development/Sortd/issues"
  },
  "homepage": "https://github.com/coffee522jelly-development/Sortd#readme",
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1"
  }
}
