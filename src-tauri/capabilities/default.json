{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-delete-new-folders",
    "allow-organize-files",
    "allow-get-organization-preview",
    "allow-classify-folders",
    "allow-get-classification-preview",
    "allow-undo-last-operation",
    "allow-empty-recycle-bin",
    "allow-organize-today-files",
    "allow-delete-duplicate-files",
    "allow-get-ai-models",
    "allow-get-ai-organization-preview",
    "allow-execute-ai-organization",
    "notification:default",
    "dialog:default",
    "core:window:default"
  ]
}
