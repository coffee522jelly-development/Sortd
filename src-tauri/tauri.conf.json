{
  "productName": "Sortd",
  "version": "1.0.0",
  "identifier": "com.example.sortd",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Sortd",
        "width": 480,
        "height": 580,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "Japanese"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "ja-JP"
      }
    }
  }
}
